# Configuración de ejemplo para el proyecto UniLevel
# Copiar este archivo a .env y llenar con tus valores

# Entorno
FLASK_ENV=development
FLASK_DEBUG=True

# Clave secreta (cambiar en producción)
SECRET_KEY=dev-secret-key-change-in-production

# Configuración de base de datos (futuro)
# DATABASE_URL=postgresql://usuario:password@localhost/unilevel

# Correo electrónico (futuro)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-password

# Otras configuraciones
DEBUG=True
TESTING=False
